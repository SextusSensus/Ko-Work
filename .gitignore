# Backups / scratch
*.bak
*.bak_*
*.with_reacq_fix.bak
*.bak_precmdbox

# Python cache
__pycache__/
*.pyc

# Dated backup snapshots
_opt_backup_*/

# Run logs / transient
*.err
_lastrun_*
last_target.txt
frame.jpg

# Session archive (moved backups + scratch; see _backups/README.txt)
K1Finder/_backups/

# Offline pip wheel closures (large binaries; regenerate per K1Finder/wheels/README.md)
K1Finder/wheels/*.whl

# Auto-downloaded YOLO / ultralytics model weights (regenerated on first use)
*.pt

# Generated file-tree manifests (regenerated on the robot by tree_manifest.py)
K1Finder/k1_tree.txt
K1Finder/k1_paths.json
K1Finder/k1_paths_list.txt

# Local Claude Code settings (per-machine)
.claude/settings.local.json
