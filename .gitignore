# Backups / scratch
*.bak
*.bak_*
*.with_reacq_fix.bak
*.bak_precmdbox

# Python cache
__pycache__/
*.pyc

# Dated backup snapshots
_opt_backup_*/

# Run logs / transient
*.err
_lastrun_*
last_target.txt
frame.jpg

# Session archive (moved backups + scratch; see _backups/README.txt)
**/_backups/

# Offline pip wheel closures (large binaries; regenerate per models/wheels/README.md)
models/wheels/*.whl

# Model blobs -- fetched/exported on demand, not tracked raw in git (see models/README.md)
models/*.onnx
models/*.engine

# Auto-downloaded YOLO / ultralytics model weights (regenerated on first use)
*.pt

# Generated file-tree manifests (regenerated on the robot by tree_manifest.py)
k1_tree.txt
k1_paths.json
k1_paths_list.txt

# Offloaded run bundles (P6.2/P6.3): pulled per-machine, large .rrd/JSONL; the run
# index is derived on demand by desktop/Runs.ps1. Never tracked in git.
runs/

# Local Map domain ingest keeps small pose/label manifests under domains/*/runs/
# (not robot offload bundles). Force-track those provenance files.
!desktop/localmap-data/domains/*/runs/
!desktop/localmap-data/domains/*/runs/**


# Local Claude Code settings (per-machine)
.claude/settings.local.json

# Node deps (telemetry bridge)
node_modules/

# Local behavior-diff gate harness (ROS/onnxruntime stubs + synthetic clip; machine-
# specific, must never ship). Persistent dev aid for the IMPLEMENTATION_README refactor;
# rebuildable from the k1finder-local-gate memory note. See _gate/README.md.
_gate/

# Aurora offloaded local-map data (lives on the robot; regenerated by aurora_offload_map.py)
robot/aurora/localmap/

# Optional Meshy.ai local drop-ins (paid / CC BY / experiments — not for git redistribution).
# See desktop/localmap-viewer/assets/MESHY.md
desktop/localmap-viewer/assets/library/meshy-local/**
!desktop/localmap-viewer/assets/library/meshy-local/README.md
!desktop/localmap-viewer/assets/library/meshy-local/.gitkeep

# Autotune outputs (labelled .rrd ~400 MB each) -- per-machine, viewable via desktop/View-Autotune.ps1
autotune/
# Offline analysis venv (rerun 0.23.1 + CUDA torch + ultralytics) and NPU venv
.venv-analysis/
.venv-npu/
__pycache__/
